{
  "name": "web-scrapper",
  "private": true,
  "version": "0.2.0",
  "description": "Product layer (dashboard + API) on top of a pinned, unmodified Firecrawl engine",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/egress-proxy",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "firecrawl:fetch": "bash scripts/fetch-firecrawl.sh",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @ws/api",
    "db:migrate": "npm run db:migrate -w @ws/api",
    "user:create": "npm run user:create -w @ws/api --",
    "dev:api": "npm run dev -w @ws/api",
    "dev:web": "npm run dev -w @ws/web"
  }
}
