# Interpolation defaults for the included upstream firecrawl/docker-compose.yaml.
# Blank values = upstream feature disabled (LLM extraction, Supabase auth, SearXNG, Slack, ...).
# Root .env is loaded after this file and wins for any key set in both.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OLLAMA_BASE_URL=
AUTUMN_SECRET_KEY=
SLACK_WEBHOOK_URL=
BULL_AUTH_KEY=
TEST_API_KEY=
SUPABASE_ANON_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_TOKEN=
SELF_HOSTED_WEBHOOK_URL=
LOGGING_LEVEL=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=
NUQ_BACKEND=
ALLOW_LOCAL_WEBHOOKS=
BLOCK_MEDIA=
