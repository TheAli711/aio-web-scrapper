# Copy to .env and adjust. Used by docker compose (interpolation + app-api env_file)
# and by `npm run dev:api` / scripts on the host.

# ---------------------------------------------------------------- application API (apps/api)
# Host-side dev: Postgres published by compose on 127.0.0.1:5433
DATABASE_URL=postgres://webscraper:webscraper@localhost:5433/webscraper
API_PORT=4000
LOG_LEVEL=info
# Origin of the dashboard. Cookie-authenticated POST/PUT/PATCH/DELETE from other origins are rejected.
APP_ORIGIN=http://localhost:3000
# Set true when serving over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Allow self-service sign-up from the dashboard. Set false and use `npm run user:create` instead.
ALLOW_SIGNUP=true

# Firecrawl (never expose this to the internet: self-hosted Firecrawl has no auth).
# Host-side dev goes through the loopback gateway; in compose app-api uses http://api:3002.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=self-hosted
FIRECRAWL_REQUEST_TIMEOUT_MS=30000

# Object storage for page bodies. Only "local" is implemented in Phase 2.
STORAGE_LOCAL_DIR=./data/objects

# ---------------------------------------------------------------- limits
MAX_CRAWL_PAGES=500
MAX_CRAWL_DEPTH=10
DEFAULT_SCRAPE_TIMEOUT_MS=30000
MAX_SCRAPE_TIMEOUT_MS=90000
MAX_RESULT_BYTES=5242880
MAX_ACTIVE_JOBS_PER_USER=10
MAX_CRAWL_DURATION_MS=3600000
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_JOB_CREATE_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
RECONCILE_INTERVAL_MS=2000

# Protect GET /metrics (Prometheus text). Required in production.
METRICS_TOKEN=

# ---------------------------------------------------------------- SSRF / egress
# Credentials Firecrawl uses to reach egress-proxy (internal network only). Change them.
EGRESS_PROXY_USERNAME=firecrawl
EGRESS_PROXY_PASSWORD=change-me-egress
EGRESS_ALLOWED_PORTS=80,443,8080,8443
# EXPLICIT trusted internal hosts, exempt from private-address blocking at BOTH the API
# pre-check and the egress proxy. Leave EMPTY in any shared/production deployment.
# The e2e test profile sets this to "testsite".
TRUSTED_TEST_HOSTS=

# ---------------------------------------------------------------- Firecrawl sizing (upstream vars)
NUM_WORKERS_PER_QUEUE=4
