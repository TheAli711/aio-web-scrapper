# Copy to .env and adjust. Used by docker compose (interpolation + app-api env_file)
# and by `npm run dev:api` / scripts on the host.

# ---------------------------------------------------------------- application API (apps/api)
# Host-side dev: Postgres published by compose on 127.0.0.1:5433
DATABASE_URL=postgres://webscraper:webscraper@localhost:5433/webscraper
API_PORT=4000
LOG_LEVEL=info
# Origin of the dashboard. Cookie-authenticated POST/PUT/PATCH/DELETE from other origins are rejected.
APP_ORIGIN=http://localhost:3000
# Set true when serving over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Allow self-service sign-up from the dashboard. Set false and use `npm run user:create` instead.
ALLOW_SIGNUP=true

# Firecrawl (never expose this to the internet: self-hosted Firecrawl has no auth).
# Host-side dev goes through the loopback gateway; in compose app-api uses http://api:3002.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=self-hosted
FIRECRAWL_REQUEST_TIMEOUT_MS=30000
# User-Agent for target requests. Default: Chrome on Linux (matches the engine's Chromium, so
# bot walls don't see a UA/browser mismatch). Uncomment to override.
# FIRECRAWL_USER_AGENT=

# Branding extraction service (logo, favicon, colors). Compose sets http://brand-service:4100;
# the service is not published to the host, so host-side API dev (npm run dev:api) reports
# branding as ENGINE_UNAVAILABLE unless you expose it yourself.
BRAND_SERVICE_URL=http://localhost:4100
BRAND_SERVICE_TIMEOUT_MS=60000

# Object storage for page bodies. Only "local" is implemented in Phase 2.
STORAGE_LOCAL_DIR=./data/objects

# ---------------------------------------------------------------- limits
MAX_CRAWL_PAGES=2000
MAX_CRAWL_DEPTH=10
DEFAULT_SCRAPE_TIMEOUT_MS=30000
MAX_SCRAPE_TIMEOUT_MS=90000
MAX_RESULT_BYTES=5242880
MAX_ACTIVE_JOBS_PER_USER=10
MAX_CRAWL_DURATION_MS=3600000
MAX_MAP_URLS=10000
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_JOB_CREATE_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
RECONCILE_INTERVAL_MS=2000

# Protect GET /metrics (Prometheus text). Required in production.
METRICS_TOKEN=

# ---------------------------------------------------------------- SSRF / egress
# Credentials Firecrawl uses to reach egress-proxy (internal network only). Change them.
EGRESS_PROXY_USERNAME=firecrawl
EGRESS_PROXY_PASSWORD=change-me-egress
EGRESS_ALLOWED_PORTS=80,443,8080,8443
# EXPLICIT trusted internal hosts, exempt from private-address blocking at BOTH the API
# pre-check and the egress proxy. Leave EMPTY in any shared/production deployment.
# The e2e test profile sets this to "testsite".
TRUSTED_TEST_HOSTS=

# ---------------------------------------------------------------- Firecrawl sizing (upstream vars)
NUM_WORKERS_PER_QUEUE=4

# ---------------------------------------------------------------- traffic estimator (apps/traffic-estimator)
# Own Postgres, published on 127.0.0.1:5434 for host-side development. API on 127.0.0.1:4200.
TRAFFIC_DB_USER=traffic
TRAFFIC_DB_PASSWORD=traffic
TRAFFIC_DB_NAME=traffic
TRAFFIC_DB_HOST_PORT=5434
TRAFFIC_API_HOST_PORT=4200
# Every TE_* variable in apps/traffic-estimator/src/traffic_estimator/settings.py can be set here.
# Collectors run per domain (JSON list). Remove "commoncrawl" for large batches: its index API is
# heavily rate limited (see docs/traffic-estimator/data-sources.md).
TE_ENABLED_COLLECTORS=["lists","commoncrawl","crawl","dns"]
# Bulk ranked lists loaded on a schedule (first load downloads ~2.7 GB: Tranco full 100 MB,
# Majestic 80 MB, Open PageRank 120 MB, CrUX 9 MB, Common Crawl domain ranks 2.3 GB).
TE_LIST_PROVIDERS=["tranco","majestic","openpagerank","crux_top","cc_webgraph"]
TE_CC_WEBGRAPH_TOP_N=5000000
TE_WORKER_CONCURRENCY=8
TE_CRAWL_PAGES=15
TE_LOG_LEVEL=info
# Identify the crawler honestly (a contact address is good practice for the public services).
# TE_USER_AGENT=traffic-estimator/0.1 (+https://example.com/bot; mailto:ops@example.com)
# Host-side development (python -m traffic_estimator ...): direct internet, local Postgres.
# TE_DATABASE_URL=postgresql+psycopg://traffic:traffic@localhost:5434/traffic
# TE_DATA_DIR=./data/traffic
