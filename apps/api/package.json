{
  "name": "@ws/api",
  "version": "0.2.0",
  "private": true,
  "description": "Application layer: auth, projects, jobs, results, public API. Talks to Firecrawl through the ScrapingEngine adapter.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "user:create": "tsx --env-file-if-exists=../../.env src/scripts/create-user.ts",
    "openapi": "tsx src/scripts/openapi.ts",
    "test": "vitest run",
    "test:e2e": "E2E=1 vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.12.5",
    "html-to-text": "^10.0.1",
    "pg": "^8.23.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
